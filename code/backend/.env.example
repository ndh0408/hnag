# =========================================================================
# HNAG BACKEND — environment variables (.env)
# =========================================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,https://tothanhthuy.cloud,https://dash.tothanhthuy.cloud

# Database
DATABASE_URL=postgresql://hnag:hnag@localhost:5432/hnag?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — MUST be a strong random string (>= 32 chars) in production or the app
# refuses to boot. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-chars-0123456789

# Auth (email-only OTP). Phone OTP has been removed.
# SMTP is required to actually send login codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hôm Nay Ăn Gì? <you@example.com>
# Dev only: never set in production. If 1 (and NODE_ENV != production and no SMTP),
# the OTP code is returned in the API response for local testing.
OTP_RETURN_CODE_IN_RESPONSE=0

# Admin GraphQL access — comma-separated emails allowed into /graphql (RBAC).
# Leave empty to lock the admin endpoint entirely.
ADMIN_EMAILS=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Per-user daily cap on real LLM caption calls (cost guard). Optional.
LLM_DAILY_CAP=

# Payments — SePay bank-transfer webhook secret. MANDATORY: the webhook is
# rejected entirely if this is unset (prevents forged premium grants).
SEPAY_WEBHOOK_TOKEN=
# Promo codes "CODE:plan:months" comma-separated, e.g. BETA2026:yearly:12
# Empty = no promo codes accepted (no hardcoded defaults).
PROMO_CODES=
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Voice
VBEE_API_KEY=
WHISPER_HOST=http://whisper:8000

# Maps & Geo
MAPBOX_TOKEN=
OPENWEATHER_API_KEY=

# Delivery partners (sandbox)
GRABFOOD_API_KEY=
SHOPEEFOOD_API_KEY=
BEFOOD_API_KEY=

# Push (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payment (Vietnamese)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=

# Storage
S3_BUCKET=hnag-media
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
DATADOG_API_KEY=
