# =========================================================================
# HNAG BACKEND — environment variables (.env)
# =========================================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,https://tothanhthuy.cloud,https://dash.tothanhthuy.cloud

# Database
DATABASE_URL=postgresql://hnag:hnag@localhost:5432/hnag?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice
VBEE_API_KEY=
WHISPER_HOST=http://whisper:8000

# Maps & Geo
MAPBOX_TOKEN=
OPENWEATHER_API_KEY=

# Delivery partners (sandbox)
GRABFOOD_API_KEY=
SHOPEEFOOD_API_KEY=
BEFOOD_API_KEY=

# Push (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payment (Vietnamese)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=

# Storage
S3_BUCKET=hnag-media
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
DATADOG_API_KEY=
