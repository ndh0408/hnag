    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.14",
    "openai": "^4.55.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
