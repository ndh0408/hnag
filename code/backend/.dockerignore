# ---- Dependencies (reinstalled inside the image) ----
node_modules

# ---- Build output (produced by the build stage) ----
dist
build
coverage

# ---- Secrets & credentials (never bake into an image) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.keystore

# ---- VCS & local tooling ----
.git
.gitignore
.dockerignore
Dockerfile
.vscode
.idea

# ---- Tests (not needed for the prod image) ----
test

# ---- Logs & OS cruft ----
*.log
npm-debug.log
.DS_Store
