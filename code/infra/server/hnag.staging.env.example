# =============================================================================
# HNAG STAGING env — copy to hnag.staging.env on server and fill secrets.
# Keep separate from hnag.env (prod). Different DB password, different
# Apple bundle id (if shipping a staging build), different Cloudflare tunnel.
# =============================================================================
GHCR_OWNER=ndh0408
HNAG_VERSION=develop

# Distinct password from prod — confirm with the file at
# secrets/postgres_stage_password (rendered into the container via
# Docker secret).
POSTGRES_STAGE_PASSWORD=__paste_from_secrets/postgres_stage_password__

# JWT — DIFFERENT keys from prod so a leaked staging key can't open prod.
JWT_SECRET=__long_random_staging_only__
JWT_REFRESH_SECRET=__long_random_staging_only_different__

# AI providers — recommended: a separate OpenAI project with a smaller
# spend cap so staging experiments don't eat into the production budget.
OPENAI_API_KEY=sk-staging-
ANTHROPIC_API_KEY=sk-ant-staging-

# Mapbox — same public token is fine (it's pk., per-domain-restricted)
MAPBOX_TOKEN=pk.

# Firebase Admin — staging project
FIREBASE_PROJECT_ID=hnag-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Payment — staging never accepts real money. Set SEPAY_WEBHOOK_TOKEN to a
# random string and SEPAY_HMAC_SECRET to another; manually POST test
# payloads. Mounts the test bank account if you have one.
SEPAY_WEBHOOK_TOKEN=stage-only-bearer
SEPAY_HMAC_SECRET=stage-only-hmac

# Storage — recommend a separate B2/S3 bucket
S3_REGION=ap-southeast-1
S3_BUCKET=hnag-media-stage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=https://<staging-key>@sentry.io/<staging-project>
SENTRY_ENVIRONMENT=staging
LOG_LEVEL=debug
PRISMA_QUERY_LOG=false           # flip to true when debugging
SLOW_QUERY_MS_THRESHOLD=150       # tighter than prod so staging surfaces regressions

# Domain (used in CORS) — staging is api-stage.tothanhthuy.cloud
PUBLIC_DOMAIN=tothanhthuy.cloud
CORS_ORIGINS=https://stage.tothanhthuy.cloud,https://dash-stage.tothanhthuy.cloud

# Apple Sign-In — use the production bundle if shipping a TestFlight
# build, OR a staging variant bundle (vn.hnag.hnag.stage) for parallel.
APPLE_BUNDLE_ID=vn.hnag.hnag

# GraphQL admin — leave UNSET in staging too; same security rules apply.
# GRAPHQL_INTROSPECTION=
# GRAPHQL_PLAYGROUND=

# OTP staging — plaintext in logs is OK (manual QA needs the codes).
OTP_DEV_LOG_PLAIN=true

# Cloudflare tunnel — separate token from prod
HNAG_STAGE_TUNNEL_TOKEN=

# Moderation
MODERATION_ABUSE_THRESHOLD=3      # tighter on staging to test the alert path

# Model routing (cheaper everywhere on staging)
MODEL_CHEAP=gpt-4o-mini
MODEL_PREMIUM=gpt-4o-mini
MODEL_FALLBACK=gpt-4o-mini
