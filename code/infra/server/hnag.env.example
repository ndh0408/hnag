# =============================================================================
# HNAG production env — copy to hnag.env on server and fill secrets
# =============================================================================
GHCR_OWNER=your-github-username
HNAG_VERSION=latest

POSTGRES_PASSWORD=__paste_content_of_secrets/postgres_password__

# JWT
JWT_SECRET=__long_random__
JWT_REFRESH_SECRET=__long_random_different__

# AI providers
OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant-
VBEE_API_KEY=

# Maps & weather
MAPBOX_TOKEN=pk.
OPENWEATHER_API_KEY=

# Push (Firebase Admin)
FIREBASE_PROJECT_ID=hnag-prod
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Payment
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=

# VietQR / SePay (personal bank account → premium activation)
# SEPAY_WEBHOOK_TOKEN is the bearer token SePay sends in Authorization.
# SEPAY_HMAC_SECRET enables strict HMAC verification of the webhook body
# (recommended in production — once this is set, requests without a valid
# X-HNAG-Signature / X-Sepay-Signature header are rejected).
SEPAY_WEBHOOK_TOKEN=
SEPAY_HMAC_SECRET=
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=HNAG

# Promo codes — comma-separated CODE:plan:months (e.g. BETA2026:yearly:12)
PROMO_CODES=

# Apple Sign-In — expected `aud` claim on identityTokens. Default vn.hnag.hnag.
APPLE_BUNDLE_ID=vn.hnag.hnag

# GraphQL admin surface — leave UNSET in production. Set to "true" only on
# a developer workstation to enable introspection / Apollo playground.
# GRAPHQL_INTROSPECTION=
# GRAPHQL_PLAYGROUND=

# OTP debug — non-production only. Setting to "true" prints OTP plaintext
# in docker logs so manual QA can copy-paste; defaults to fingerprint-only.
# OTP_DEV_LOG_PLAIN=

# Storage (use S3-compatible like Backblaze B2 for cost — see README)
S3_REGION=ap-southeast-1
S3_BUCKET=hnag-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Domain (used in CORS + nginx)
PUBLIC_DOMAIN=tothanhthuy.cloud
CORS_ORIGINS=https://tothanhthuy.cloud,https://dash.tothanhthuy.cloud,https://app.tothanhthuy.cloud
