# Server-side ONLY backend base URL. Used by the /api/auth/* route handlers and
# src/lib/api.ts so the OTP token-exchange happens on the server and the
# access/refresh tokens live in httpOnly cookies (never readable by client JS).
# Do NOT prefix with NEXT_PUBLIC_ — that would ship it to the browser.
API_BASE_URL=https://api.tothanhthuy.cloud

# Public URLs that are safe to expose to the browser bundle.
NEXT_PUBLIC_API_URL=https://api.tothanhthuy.cloud
NEXT_PUBLIC_GRAPHQL_URL=https://api.tothanhthuy.cloud/graphql

# Legacy next-auth vars (next-auth is not currently used for the email-OTP flow;
# kept for compatibility — safe to remove once confirmed unused).
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://dash.tothanhthuy.cloud
